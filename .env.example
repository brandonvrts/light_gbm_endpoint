# Copy to .env and fill in. NEVER commit .env. No secrets live in source.
# Adapts the multifamily v2 CHURN_ pattern -> GBME_ prefix (avoids collisions).

# --- Yardi read-only DB (identifier-in contracts; lives only in core/feature_io.py) ---
GBME_DB_SERVER   = rrSQL2024
GBME_DB_DATABASE = InsightMart_Test
GBME_DB_USERNAME = your-readonly-user
GBME_DB_PASSWORD = your-password
GBME_DB_DRIVER   = ODBC Driver 18 for SQL Server

# --- Azure AD / JWT validation ---
GBME_AAD_TENANT_ID = your-tenant-id
GBME_AAD_AUDIENCE  = api://light-gbm-endpoint
# Optional: comma-separated app-ids allowed, or rely on per-contract scopes
# GBME_AAD_ALLOWED_APPS = signal-desk,marketing,multifamily-dash

# --- registry / bundles ---
GBME_BUNDLES_DIR = ./bundles
